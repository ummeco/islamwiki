# Do not auto-install peer dependencies. `next` is an OPTIONAL peer of
# @astrojs/vercel, @vercel/analytics and @vercel/speed-insights. With
# auto-install-peers on (pnpm default), pnpm pulls the full 166MB next
# package, which pushes the Vercel serverless function past the 250MB limit.
# This app is Astro-only (no next/* anywhere in lib or src), so the optional
# peer must stay unsatisfied. Combined with pnpm.peerDependencyRules.ignoreMissing
# (package.json), this keeps `next` fully out of node_modules.
auto-install-peers=false
