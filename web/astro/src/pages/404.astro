---
/**
 * FILE: pages/404.astro
 * PURPOSE: 404 page for islamwiki/read.
 * REF: P2-E3-W02-S02-T01
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noIndex={true}>
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-6xl font-bold text-brand-dark mb-4">404</h1>
    <h2 class="text-2xl font-semibold text-gray-700 mb-4">Article Not Found</h2>
    <p class="text-gray-500 mb-8 max-w-md">
      This article may not exist, may not have been published yet, or may have been moved.
    </p>
    <div class="flex gap-4">
      <a href="/" class="px-4 py-2 bg-brand-mid text-white rounded-lg hover:bg-brand-dark transition-colors">
        Go Home
      </a>
      <a href="/search" class="px-4 py-2 border border-brand-mid text-brand-mid rounded-lg hover:bg-brand-light/10 transition-colors">
        Search Articles
      </a>
    </div>
  </div>
</BaseLayout>
