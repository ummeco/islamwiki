{
  "name": "islamwiki-read",
  "version": "0.1.0",
  "private": true,
  "description": "Islam.wiki — Astro 5 SSR read surface. Public article reading, search, categories.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3041",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint src --ext .ts,.astro --max-warnings 0",
    "codegen": "graphql-codegen --config ../codegen.ts --output-dir src/graphql/generated"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vercel": "^7.0.0",
    "@sentry/astro": "^8.0.0",
    "@ummat/astro-preset": "workspace:*",
    "@ummat/graphql-client": "workspace:*",
    "@ummat/i18n": "workspace:*",
    "@ummat/shared": "workspace:*",
    "astro": "^5.0.0",
    "jose": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "urql": "^4.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "^1.0.0",
    "typescript": "catalog:"
  }
}
