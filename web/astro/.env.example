# Islam.wiki Read Surface (Astro SSR) — Environment Variables
# Copy to .env.local for local development

# GraphQL endpoint
PUBLIC_GRAPHQL_URL=https://api.ummat.dev/v1/graphql

# Auth endpoint
PUBLIC_AUTH_URL=https://auth.ummat.dev

# Site URL
PUBLIC_SITE_URL=https://islam.wiki

# Sentry — vault key SENTRY_DSN_ISLAMWIKI
SENTRY_DSN_ISLAMWIKI=
SENTRY_AUTH_TOKEN=

# Vercel cache purge — vault key VERCEL_TOKEN
VERCEL_TOKEN=

# Umami analytics
PUBLIC_UMAMI_WEBSITE_ID=
