---
/**
 * search.astro — Search results page (SSR)
 *
 * PURPOSE: Ports app/search/page.tsx. Reads ?q (and optional ?type) from
 *   Astro.url.searchParams, runs the SAME framework-independent search logic
 *   (lib/search.ts searchGrouped + lib/search-meilisearch.ts searchMeilisearch with
 *   static fallback), and server-renders grouped results. The search INPUT box is a
 *   React island (client:load) for the debounced live-preview dropdown.
 * CONVERSION:
 *   - Next searchParams (Promise) → Astro.url.searchParams (sync).
 *   - SearchInput 'use client' → SearchInput island via client:load.
 *   - next/link <Link> → plain <a>.
 *   - metadata robots:{index:false} → <meta name="robots" content="noindex, follow">.
 * SECURITY (XSS): highlightText splits text into {text, highlight} parts and each part
 *   is rendered as an Astro text expression ({p.text}) inside <span>/<mark>. Astro
 *   HTML-escapes interpolated expressions, so the user query and result text are never
 *   injected as raw HTML. No set:html / dangerouslySetInnerHTML is used. The filter-key
 *   allowlist lives inside lib/search-meilisearch.ts / the /api/search route (meili-filter
 *   sanitize); this page only passes a plain typeFilter string through to searchMeilisearch,
 *   which validates it.
 * REF: ports app/search/page.tsx (P2-E3 search migration) · D-P2-STACK-CANON
 */
import Base from '../layouts/Base.astro'
import { searchGrouped, type GroupedResults } from '../../lib/search'
import { searchMeilisearch, isMeilisearchConfigured } from '../../lib/search-meilisearch'
import { SearchInput } from '../components/search/SearchInput'

const TYPE_ICONS: Record<string, string> = {
  quran: '/quran',
  hadith: '/hadith',
  seerah: '/seerah',
  person: '/people',
  book: '/books',
  article: '/articles',
  video: '/videos',
  audio: '/audio',
  wiki: '/wiki',
  sect: '/sects',
}

function highlightText(text: string, query: string) {
  if (!query) return [{ text, highlight: false }]
  const lower = text.toLowerCase()
  const qLower = query.toLowerCase()
  const parts: { text: string; highlight: boolean }[] = []
  let lastIndex = 0
  let idx = lower.indexOf(qLower)
  while (idx !== -1) {
    if (idx > lastIndex) parts.push({ text: text.slice(lastIndex, idx), highlight: false })
    parts.push({ text: text.slice(idx, idx + query.length), highlight: true })
    lastIndex = idx + query.length
    idx = lower.indexOf(qLower, lastIndex)
  }
  if (lastIndex < text.length) parts.push({ text: text.slice(lastIndex), highlight: false })
  if (parts.length === 0) parts.push({ text, highlight: false })
  return parts
}

const query = Astro.url.searchParams.get('q') || ''
const typeFilter = Astro.url.searchParams.get('type') || ''

let data: GroupedResults = { groups: [], total: 0 }
// S9-16 / S9-20 / S9-24: Use Meilisearch when configured (full-text, Arabic support).
// Falls back to static in-memory search when Meilisearch is not available.
if (query) {
  if (isMeilisearchConfigured()) {
    const meiliData = await searchMeilisearch(query, typeFilter, 30)
    if (meiliData) {
      data = meiliData
    } else {
      // Meilisearch failed (network, empty index) — fall back to static search
      data = searchGrouped(query, 0)
      if (typeFilter) {
        data = {
          groups: data.groups.filter((g) => g.type === typeFilter),
          total: data.groups
            .filter((g) => g.type === typeFilter)
            .reduce((sum, g) => sum + g.total, 0),
        }
      }
    }
  } else {
    data = searchGrouped(query, 0)
    if (typeFilter) {
      data = {
        groups: data.groups.filter((g) => g.type === typeFilter),
        total: data.groups
          .filter((g) => g.type === typeFilter)
          .reduce((sum, g) => sum + g.total, 0),
      }
    }
  }
}

const title = 'Search — Islam.wiki'
const description =
  'Search the Quran, Hadith, scholars, books, articles, and all Islamic content on Islam.wiki.'
---

<Base title={title} description={description}>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="py-8" id="main-content">
    <div class="section-container">
      {/* Search bar (React island) */}
      <div class="mx-auto max-w-2xl">
        <SearchInput
          placeholder="Search Quran, Hadith, scholars, topics..."
          autoFocus
          client:load
        />
      </div>

      {/* Results for server-rendered query */}
      {query && (
        <div class="mt-8">
          <div class="mb-6 flex items-baseline gap-3">
            <h1 class="text-lg font-semibold text-white">
              {data.total} result{data.total !== 1 ? 's' : ''} for &ldquo;{query}&rdquo;
            </h1>
            {typeFilter && (
              <a
                href={`/search?q=${encodeURIComponent(query)}`}
                class="text-xs text-iw-accent hover:underline"
              >
                Clear filter
              </a>
            )}
          </div>

          {!typeFilter && data.groups.length > 1 && (
            <div class="mb-6 flex flex-wrap gap-2">
              {data.groups.map((group) => (
                <a
                  href={`/search?q=${encodeURIComponent(query)}&type=${group.type}`}
                  class="rounded-full border border-iw-border px-3 py-1 text-xs font-medium text-iw-text-secondary transition-colors hover:border-iw-accent hover:text-white"
                >
                  {group.label} ({group.total})
                </a>
              ))}
            </div>
          )}

          <div class="space-y-8">
            {data.groups.map((group) => (
              <section>
                <div class="mb-3 flex items-center gap-3">
                  <a
                    href={TYPE_ICONS[group.type] || '#'}
                    class="text-xs font-bold tracking-wider text-iw-accent uppercase"
                  >
                    {group.label}
                  </a>
                  <span class="text-xs text-iw-text-muted">{group.total} result{group.total !== 1 ? 's' : ''}</span>
                </div>
                <div class="space-y-1">
                  {group.results.map((result) => {
                    const titleParts = highlightText(result.title, query)
                    const snippetParts = highlightText(result.snippet, query)
                    return (
                      <a
                        href={result.url}
                        class="block rounded-lg border border-iw-border/50 bg-iw-surface/40 px-4 py-3 transition-colors hover:border-iw-accent/30 hover:bg-iw-surface/80"
                      >
                        <div class="flex items-baseline gap-2">
                          {result.meta && (
                            <span class="shrink-0 text-[10px] text-iw-text-muted">{result.meta}</span>
                          )}
                          <span class="text-sm font-medium text-white">
                            {titleParts.map((p) =>
                              p.highlight ? (
                                <mark class="rounded-sm bg-iw-accent/20 text-iw-accent">{p.text}</mark>
                              ) : (
                                <span>{p.text}</span>
                              )
                            )}
                          </span>
                        </div>
                        <p class="mt-1 line-clamp-2 text-xs text-iw-text-muted">
                          {snippetParts.map((p) =>
                            p.highlight ? (
                              <mark class="rounded-sm bg-iw-accent/20 text-iw-accent">{p.text}</mark>
                            ) : (
                              <span>{p.text}</span>
                            )
                          )}
                        </p>
                      </a>
                    )
                  })}
                </div>
              </section>
            ))}
          </div>

          {data.total === 0 && (
            <div class="py-16 text-center">
              <p class="text-iw-text-muted">No results found for &ldquo;{query}&rdquo;</p>
              <p class="mt-2 text-xs text-iw-text-muted">Try different keywords or check the spelling</p>
            </div>
          )}
        </div>
      )}

      {!query && (
        <div class="py-16 text-center">
          <p class="text-iw-text-muted">Type to search across Quran, Hadith, scholars, books, and more</p>
        </div>
      )}
    </div>
  </div>
</Base>
