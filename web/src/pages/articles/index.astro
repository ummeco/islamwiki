---
/**
 * articles/index.astro — Articles listing (static, SSG)
 *
 * PURPOSE: Ports app/articles/page.tsx. Reads getArticles() from the same
 *   framework-independent lib/data/articles reader the Next page used, then renders
 *   the searchable/tabbed grid as a React island.
 * CONVERSION: ArticlesGrid 'use client' component → client:load island.
 * REF: ports app/articles/page.tsx (articles-wiki migration group)
 */
import Base from '../../layouts/Base.astro'
import { getArticles } from '../../../lib/data/articles'
import { ArticlesGrid } from '../../components/listings/ArticlesGrid'

const articles = getArticles()

const title = 'Articles — Islamic Encyclopedia'
const description =
  'Encyclopedic articles on all aspects of Islam: worship, theology, history, jurisprudence, and more. Scholar-verified and community-driven.'
---

<Base title={title} description={description}>
  <div class="section-container py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Articles</h1>
      <p class="mt-2 text-iw-text-secondary">
        Encyclopedic articles on all aspects of Islam. Scholar-verified and community-driven.
      </p>
    </div>

    <ArticlesGrid articles={articles} client:load />
  </div>
</Base>
