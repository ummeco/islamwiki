---
/**
 * quran/page/[page].astro — Mushaf page viewer, SSG (all 604 prerendered)
 *
 * PURPOSE: Ports app/quran/page/[page]/page.tsx. Renders all ayahs on a Mushaf
 *   page (1..604), grouped by surah, via the interactive MushafPageView.
 * CONVERSION NOTES:
 *   - generateStaticParams → getStaticPaths(): page 1..604.
 *   - getAyahsByPage() imported VERBATIM from lib/data/quran (framework-independent).
 *   - MushafPageView is 'use client' → React island (client:load).
 *   - Invalid page or empty groups → Astro.redirect('/404') (replaces notFound()).
 * REF: P2 quran group · ports app/quran/page/[page]/page.tsx
 */
export const prerender = true

import Base from '../../../layouts/Base.astro'
import { getAyahsByPage } from '@/lib/data/quran'
import { MushafPageView } from '@/components/quran/MushafPageView'

export function getStaticPaths() {
  return Array.from({ length: 604 }, (_, i) => ({ params: { page: String(i + 1) } }))
}

const { page: pageParam } = Astro.params
const pageNumber = parseInt(pageParam ?? '', 10)

if (Number.isNaN(pageNumber) || pageNumber < 1 || pageNumber > 604) {
  return Astro.redirect('/404')
}

const groups = getAyahsByPage(pageNumber)
if (!groups.length) return Astro.redirect('/404')

const prevPage = pageNumber > 1 ? pageNumber - 1 : null
const nextPage = pageNumber < 604 ? pageNumber + 1 : null

const firstGroup = groups[0]
const lastGroup = groups[groups.length - 1]
const totalVerses = groups.reduce((s, g) => s + g.ayahs.length, 0)

const title = `Page ${pageNumber} — Quran · Islam.wiki`
const description = `Read Mushaf page ${pageNumber} of the Quran with Arabic text, transliteration, and translation.`
---

<Base title={title} description={description}>
  <main id="main-content">
    <div class="section-container py-12">
      {/* Breadcrumb */}
      <nav class="mb-6 text-sm text-iw-text-secondary">
        <a href="/quran" class="hover:text-iw-text">Quran</a>
        <span class="mx-2 text-iw-border">/</span>
        <span class="text-iw-text">Page {pageNumber}</span>
      </nav>

      {/* Header */}
      <div class="mb-6 text-center">
        <p class="text-sm text-iw-accent">Page {pageNumber} of 604</p>
        <h1 class="mt-2 text-2xl font-bold text-white">
          {firstGroup.surah.name_en}
          {lastGroup.surah.number !== firstGroup.surah.number && ` — ${lastGroup.surah.name_en}`}
        </h1>
        <p class="mt-1 text-sm text-iw-text-secondary">
          {totalVerses} verses
        </p>
      </div>

      {/* Prev/Next navigation */}
      <div class="mx-auto mb-8 flex max-w-3xl items-center justify-between">
        {prevPage ? (
          <a
            href={`/quran/page/${prevPage}`}
            class="flex items-center gap-2 rounded-lg border border-iw-border px-4 py-2 text-sm text-iw-text-secondary transition-colors hover:border-iw-text-muted hover:text-iw-text"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Page {prevPage}
          </a>
        ) : <div />}
        {nextPage ? (
          <a
            href={`/quran/page/${nextPage}`}
            class="flex items-center gap-2 rounded-lg border border-iw-border px-4 py-2 text-sm text-iw-text-secondary transition-colors hover:border-iw-text-muted hover:text-iw-text"
          >
            Page {nextPage}
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : <div />}
      </div>

      {/* Page content with mode toggle (React island) */}
      <MushafPageView pageNumber={pageNumber} groups={groups} client:load />

      {/* Bottom navigation */}
      <div class="mx-auto mt-12 flex max-w-3xl items-center justify-between border-t border-iw-border pt-6">
        {prevPage ? (
          <a
            href={`/quran/page/${prevPage}`}
            class="flex items-center gap-2 text-sm text-iw-text-secondary transition-colors hover:text-iw-text"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <div>
              <div class="text-xs text-iw-text-muted">Previous</div>
              <div class="font-medium">Page {prevPage}</div>
            </div>
          </a>
        ) : <div />}
        <a href="/quran" class="text-xs text-iw-text-muted transition-colors hover:text-iw-accent">
          All Surahs
        </a>
        {nextPage ? (
          <a
            href={`/quran/page/${nextPage}`}
            class="flex items-center gap-2 text-right text-sm text-iw-text-secondary transition-colors hover:text-iw-text"
          >
            <div>
              <div class="text-xs text-iw-text-muted">Next</div>
              <div class="font-medium">Page {nextPage}</div>
            </div>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : <div />}
      </div>
    </div>
  </main>
</Base>
