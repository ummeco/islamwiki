---
/**
 * donate/index.astro — Support / donate page (static)
 *
 * PURPOSE: Phase 1 donate stub. Ports app/donate/page.tsx verbatim copy.
 * REF: P2-E3-W02-S02-T01 · ports app/donate/page.tsx
 */
import Base from '../../layouts/Base.astro'

const title = 'Support Islam.wiki — Keep Islamic Knowledge Free'
const description =
  'Help keep Islam.wiki free and growing. Your donation funds content, search, and hosting.'
---

<Base title={title} description={description}>
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16 text-center">
    <h1 class="text-3xl font-bold mb-4">Support Islam.wiki</h1>
    <p class="text-lg text-gray-600 mb-8">
      Islam.wiki is free for everyone — no ads, no paywalls. Your donation keeps the knowledge
      base running and growing for the global Muslim community.
    </p>
    <p class="text-gray-500 mb-6">Online donations are coming soon. Jazakallah khayran.</p>
    <a href="/" class="text-green-700 hover:underline">
      ← Return to Islam.wiki
    </a>
  </main>
</Base>
