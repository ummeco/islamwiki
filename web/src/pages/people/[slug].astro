---
/**
 * people/[slug].astro — Person biography page (static SSG). Ports app/people/[slug]/page.tsx.
 *
 * CONVERSION NOTES:
 *   - generateStaticParams → getStaticPaths (getAllPeople, reused verbatim).
 *   - getLocale() (next/headers) → Astro.locals.locale (set by src/middleware.ts).
 *   - Biography markdown rendered through renderMarkdownSafe() — wiki-editable content,
 *     so it passes lib/sanitize.ts sanitizeHtml() before set:html (XSS release gate).
 *   - PersonJsonLd / BreadcrumbJsonLd JSX components replaced by safeJsonLd() + inline
 *     <script type="application/ld+json"> (same escaped payload).
 *   - ContentTabs rendered server-side (anchor-only); EditButton is a client:load island
 *     (auth + trust-level gate via /api/auth/me preserved exactly).
 *   - next/link → <a>; next/image not used here.
 * REF: ports app/people/[slug]/page.tsx · people-history group · [XSS] bio content
 */
import Base from '../../layouts/Base.astro'
import {
  getPersonOrNarratorBySlug,
  getAllPeople,
  getRelationships,
  getPersonPlaces,
} from '../../../lib/data/people'
import { getBooksByAuthor } from '../../../lib/data/books'
import { safeJsonLd } from '../../../components/seo/json-ld'
import { getHreflangAlternates } from '../../../components/seo/hreflang'
import { ogImageUrl } from '../../../lib/og'
import { formatIslamicYear } from '../../../lib/dates/hijri'
import { renderMarkdownSafe } from '../../lib/render-markdown'
import { ContentTabs } from '../../components/wiki/ContentTabs'
import { EditButton } from '../../components/wiki/EditButton'

// Static content page — prerendered to HTML at build time (SSG content/SEO).
export const prerender = true

export function getStaticPaths() {
  return getAllPeople().map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params as { slug: string }
const person = getPersonOrNarratorBySlug(slug)
if (!person) return Astro.redirect('/404')

const locale = Astro.locals.locale ?? 'en'
const relationships = getRelationships(person.id)
const places = getPersonPlaces(person.id)
const authoredBooks = getBooksByAuthor(slug)

// Locale-aware biography selection (verbatim from the Next page logic).
const bio =
  locale === 'id' && person.bio_id
    ? person.bio_id
    : locale === 'ar' && person.bio_ar
      ? person.bio_ar
      : person.bio_en
const bioHtml = bio ? renderMarkdownSafe(bio) : ''

const dates = [
  person.birth_year_ah || person.birth_year_ce
    ? `b. ${formatIslamicYear(person.birth_year_ah, person.birth_year_ce)}`
    : '',
  person.death_year_ah || person.death_year_ce
    ? `d. ${formatIslamicYear(person.death_year_ah, person.death_year_ce)}`
    : '',
]
  .filter(Boolean)
  .join(' — ')

const title = person.name_en
const description = `Biography of ${person.name_en}${dates ? ` (${dates})` : ''}. ${person.bio_short_en || 'Islamic scholar and historical figure.'}`
const ogImage = ogImageUrl({
  title: person.name_en,
  section: 'People',
  arabic: person.name_ar,
  subtitle: dates || person.era,
})
const alternates = getHreflangAlternates(`/people/${slug}`)

const personJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name_en,
  url: `https://islam.wiki/people/${slug}`,
}
if (person.name_ar) personJsonLd.alternateName = person.name_ar
if (person.birth_year_ah) personJsonLd.birthDate = `${person.birth_year_ah}h`
if (person.death_year_ah) personJsonLd.deathDate = `${person.death_year_ah}h`
if (person.bio_short_en) personJsonLd.description = person.bio_short_en

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'People', item: 'https://islam.wiki/people' },
    { '@type': 'ListItem', position: 2, name: person.name_en, item: `https://islam.wiki/people/${slug}` },
  ],
}
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    {Object.entries(alternates).map(([loc, href]) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    <script type="application/ld+json" set:html={safeJsonLd(personJsonLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(breadcrumbJsonLd)} />
  </Fragment>

  <main id="main-content">
    <div class="section-container py-8">
      <ContentTabs basePath={`/people/${slug}`} activeTab="read" canEdit />

      <div class="grid gap-8 lg:grid-cols-3">
        <!-- Main content -->
        <div class="lg:col-span-2">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold text-white">{person.name_en}</h1>
              {person.name_ar && (
                <p class="arabic-text mt-2 text-2xl text-white/80">{person.name_ar}</p>
              )}
              {person.title && (
                <p class="mt-1 text-sm font-medium text-iw-accent">{person.title}</p>
              )}
            </div>
            <EditButton editHref={`/people/${slug}/edit`} client:load />
          </div>

          <!-- Dates — Hijri primary, CE secondary -->
          <div class="mt-4 flex flex-wrap gap-4 text-sm text-iw-text-secondary">
            {(person.birth_year_ah || person.birth_year_ce) && (
              <span>
                Born:{' '}
                <span class="text-iw-text">
                  {formatIslamicYear(person.birth_year_ah, person.birth_year_ce, false)}
                </span>
                {person.birth_year_ce && person.birth_year_ah && (
                  <span class="ml-1 text-iw-text-muted/70">({person.birth_year_ce} CE)</span>
                )}
              </span>
            )}
            {(person.death_year_ah || person.death_year_ce) && (
              <span>
                Died:{' '}
                <span class="text-iw-text">
                  {formatIslamicYear(person.death_year_ah, person.death_year_ce, false)}
                </span>
                {person.death_year_ce && person.death_year_ah && (
                  <span class="ml-1 text-iw-text-muted/70">({person.death_year_ce} CE)</span>
                )}
              </span>
            )}
          </div>

          <!-- Biography (sanitized markdown) -->
          <div class="mt-8">
            <h2 id="biography" class="mb-3 text-lg font-semibold text-white">Biography</h2>
            <div class="prose prose-invert max-w-none text-iw-text-secondary space-y-2">
              {bioHtml ? (
                <div set:html={bioHtml} />
              ) : person.bio_short_en ? (
                <p class="italic text-iw-text-muted">{person.bio_short_en}</p>
              ) : (
                <p class="italic text-iw-text-muted">Biography not yet available.</p>
              )}
            </div>
          </div>

          <!-- Books -->
          <div class="mt-8">
            <h2 id="books" class="mb-3 text-lg font-semibold text-white">Books</h2>
            {authoredBooks.length > 0 ? (
              <div class="space-y-2">
                {authoredBooks.map((book) => (
                  <a
                    href={`/books/${book.slug}`}
                    class="flex items-center gap-3 rounded-lg border border-iw-border p-3 transition-colors hover:border-iw-text-muted/20 hover:bg-iw-surface"
                  >
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-iw-accent/10 text-xs text-iw-accent">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium text-iw-text">{book.title_en}</p>
                      <p class="text-xs text-iw-text-muted capitalize">
                        {book.subject?.replace(/_/g, ' ')}
                        {book.year_written_ce ? ` · ${book.year_written_ce} CE` : ''}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="text-sm italic text-iw-text-muted">No linked books yet.</p>
            )}
          </div>
        </div>

        <!-- Info sidebar -->
        <div class="space-y-6">
          <div class="card">
            <h3 class="mb-3 text-sm font-semibold text-white">Details</h3>
            <dl class="space-y-2 text-sm">
              {person.kunyah && (
                <div>
                  <dt class="text-iw-text-muted">Kunyah</dt>
                  <dd class="text-iw-text">{person.kunyah}</dd>
                </div>
              )}
              {person.laqab && (
                <div>
                  <dt class="text-iw-text-muted">Laqab</dt>
                  <dd class="text-iw-text">{person.laqab}</dd>
                </div>
              )}
              {person.era && (
                <div>
                  <dt class="text-iw-text-muted">Era</dt>
                  <dd class="text-iw-text capitalize">{person.era.replaceAll('_', ' ')}</dd>
                </div>
              )}
              {person.category && (
                <div>
                  <dt class="text-iw-text-muted">Category</dt>
                  <dd class="text-iw-text capitalize">{person.category.replace(/_/g, ' ')}</dd>
                </div>
              )}
              {person.birth_place_name && (
                <div>
                  <dt class="text-iw-text-muted">Birth Place</dt>
                  <dd class="text-iw-text">{person.birth_place_name}</dd>
                </div>
              )}
              {person.death_place_name && (
                <div>
                  <dt class="text-iw-text-muted">Death Place</dt>
                  <dd class="text-iw-text">{person.death_place_name}</dd>
                </div>
              )}
            </dl>
          </div>

          {relationships.length > 0 && (
            <div class="card">
              <h3 class="mb-3 text-sm font-semibold text-white">Relationships</h3>
              <ul class="space-y-2">
                {relationships.map((rel) => (
                  <li class="text-sm">
                    <span class="text-iw-text-muted">{rel.relationship_type.replace(/_/g, ' ')}:</span>{' '}
                    <a href={`/people/${rel.related_person_slug}`} class="text-iw-accent hover:text-white">
                      {rel.related_person_name_en}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {places.length > 0 && (
            <div class="card">
              <h3 class="mb-3 text-sm font-semibold text-white">Places</h3>
              <ul class="space-y-2">
                {places.map((pp) => (
                  <li class="text-sm">
                    <span class="text-iw-text">{pp.place_name_en}</span>
                    {pp.role && <span class="text-iw-text-muted"> — {pp.role}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
</Base>
