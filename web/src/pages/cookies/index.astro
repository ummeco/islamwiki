---
/**
 * cookies/index.astro — Cookie policy (static)
 *
 * PURPOSE: Ports app/cookies/page.tsx verbatim copy. DRAFT — under legal review.
 * REF: P2-E3-W02-S02-T01 · ports app/cookies/page.tsx
 */
import Base from '../../layouts/Base.astro'

const title = 'Cookie Policy — Islam.wiki'
const description = 'Islam.wiki cookie policy. What cookies we use and how to control them.'
---

<Base title={title} description={description}>
  <main id="main-content">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">

      <!-- Draft banner -->
      <div class="mb-8 rounded-lg border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-300">
        <strong>DRAFT</strong> — This policy is under legal review (2026-04-25). Published for development purposes; will be replaced before public launch.
      </div>

      <div class="mb-12">
        <a href="/" class="mb-6 inline-block text-sm text-iw-text-muted hover:text-iw-accent transition-colors">
          ← Back to Islam.wiki
        </a>
        <h1 class="text-3xl font-bold text-white sm:text-4xl">Cookie Policy</h1>
        <p class="mt-3 text-sm text-iw-text-muted">Last updated: April 25, 2026</p>
      </div>

      <div class="space-y-8 text-iw-text-secondary leading-relaxed">

        <section>
          <h2 class="mb-3 text-xl font-semibold text-iw-accent">What Are Cookies</h2>
          <p>
            Cookies are small text files placed on your device when you visit a website. We use them to keep you signed in, remember your reading preferences, and understand how visitors use the site.
          </p>
        </section>

        <section>
          <h2 class="mb-3 text-xl font-semibold text-iw-accent">Cookies We Use</h2>

          <h3 class="mb-2 mt-4 font-semibold text-white/80">Essential cookies (always active)</h3>
          <p class="mb-3 text-sm">Required for Islam.wiki to function. You cannot opt out.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/20 text-white/50">
                  <th class="pb-2 text-left pr-4">Name</th>
                  <th class="pb-2 text-left pr-4">Purpose</th>
                  <th class="pb-2 text-left">Expires</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                <tr><td class="py-2 pr-4 font-mono text-xs">um_session</td><td class="py-2 pr-4">Keeps you signed in</td><td class="py-2">Session / 30 days</td></tr>
                <tr><td class="py-2 pr-4 font-mono text-xs">um_csrf</td><td class="py-2 pr-4">Cross-site request forgery protection</td><td class="py-2">Session</td></tr>
                <tr><td class="py-2 pr-4 font-mono text-xs">um_consent</td><td class="py-2 pr-4">Stores your cookie preference</td><td class="py-2">1 year</td></tr>
                <tr><td class="py-2 pr-4 font-mono text-xs">iw_reading</td><td class="py-2 pr-4">Reading preferences (font size, translation)</td><td class="py-2">1 year</td></tr>
              </tbody>
            </table>
          </div>

          <h3 class="mb-2 mt-6 font-semibold text-white/80">Analytics cookies (opt-in only)</h3>
          <p class="text-sm">
            Privacy-respecting analytics to understand how visitors use Islam.wiki — which sections are most read, what searches are common. Only fires after your consent. We do not use Google Analytics or advertising-network trackers.
          </p>
        </section>

        <section>
          <h2 class="mb-3 text-xl font-semibold text-iw-accent">Third-Party Cookies</h2>
          <ul class="list-disc space-y-1 pl-6">
            <li><strong class="text-white/90">Cloudflare</strong> may set <code class="text-xs bg-white/10 px-1 rounded">__cf_bm</code> for bot detection (strictly necessary).</li>
          </ul>
          <p class="mt-3">We do not allow advertising networks to set cookies on Islam.wiki.</p>
        </section>

        <section>
          <h2 class="mb-3 text-xl font-semibold text-iw-accent">Your Choices</h2>
          <p>
            On your first visit we show a consent banner. Choose &ldquo;Accept all&rdquo; or &ldquo;Essential only&rdquo;. Change your preference at any time via cookie settings in the footer. Clearing your browser cookies will reset your choice.
          </p>
        </section>

        <section>
          <h2 class="mb-3 text-xl font-semibold text-iw-accent">Contact</h2>
          <p>
            Questions: <a href="mailto:privacy@ummat.dev" class="text-iw-accent underline">privacy@ummat.dev</a>
          </p>
        </section>

        <div class="mt-8 border-t border-white/10 pt-6 text-sm text-iw-text-muted">
          <a href="/privacy" class="mr-4 hover:text-iw-accent transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-iw-accent transition-colors">Terms of Service</a>
        </div>
      </div>
    </div>
  </main>
</Base>
