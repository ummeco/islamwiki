---
/**
 * videos/[slug].astro — Video detail page (SSG, dynamic route).
 *
 * PURPOSE: Ports app/videos/[slug]/page.tsx. getStaticParams → getStaticPaths
 *   over getMedia('video'). Renders video embed + transcript + related-by-speaker.
 * SECURITY (HARD / XSS): Both untrusted HTML sinks are sanitized SERVER-SIDE here
 *   in the frontmatter, exactly as the Next page did at the call site:
 *     - video.embed_code → sanitizeEmbed()  (iframe origin allowlist)
 *     - video.transcript → sanitizeHtml()   (tag/attr allowlist + data: strip)
 *   The sanitized strings are emitted via set:html — raw values never reach output.
 * REF: ports app/videos/[slug]/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../layouts/Base.astro'
import { getMediaBySlug, getMedia } from '@/lib/data/media'
import { sanitizeHtml, sanitizeEmbed } from '@/lib/sanitize'
import { ogImageUrl } from '@/lib/og'
import { getHreflangAlternates } from '@/components/seo/hreflang'

// Static content page — prerendered to HTML at build time (SSG content/SEO).
export const prerender = true

export function getStaticPaths() {
  return getMedia('video').map((v) => ({ params: { slug: v.slug } }))
}

const { slug } = Astro.params
const video = getMediaBySlug(slug!)
if (!video || video.type !== 'video') {
  return Astro.redirect('/404')
}

const relatedBySpeaker = video.speaker
  ? getMedia('video')
      .filter((v) => v.speaker === video.speaker && v.slug !== video.slug)
      .slice(0, 6)
  : []

// XSS gate — sanitize server-side before set:html.
const embedHtml = video.embed_code ? sanitizeEmbed(video.embed_code) : ''
const transcriptHtml = video.transcript ? sanitizeHtml(video.transcript) : ''

const title = video.title
const description = `Watch ${video.title}${video.speaker ? ` by ${video.speaker}` : ''}. Full transcript available.`
const ogImage = ogImageUrl({ title: video.title, section: 'Video', subtitle: video.speaker || '' })
const hreflang = getHreflangAlternates(`/videos/${slug}`)
---

<Base title={title} description={description} ogImage={ogImage}>
  {Object.entries(hreflang).map(([lang, href]) => (
    <link slot="head" rel="alternate" hreflang={lang} href={href} />
  ))}
  <main id="main-content">
    <div class="section-container py-12">
      <nav class="mb-4 text-sm text-iw-text-secondary">
        <a href="/videos" class="hover:text-iw-text">Videos</a>
        <span class="mx-2">/</span>
        <span class="text-iw-text">{video.title}</span>
      </nav>

      <div class="mx-auto max-w-4xl">
        <h1 class="text-2xl font-bold text-white">{video.title}</h1>
        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-iw-text-secondary">
          {video.speaker && <span class="text-iw-accent">{video.speaker}</span>}
          {video.duration && <span>{video.duration}</span>}
        </div>

        {/* Video embed */}
        <div class="mt-6 aspect-video overflow-hidden rounded-xl border border-iw-border bg-iw-surface">
          {video.embed_code ? (
            <div set:html={embedHtml} />
          ) : (
            <div class="flex h-full flex-col items-center justify-center gap-3">
              <svg class="h-12 w-12 text-iw-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {video.external_url ? (
                <a
                  href={video.external_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-iw-accent/15 px-4 py-2 text-sm font-medium text-iw-accent hover:bg-iw-accent/25"
                >
                  Watch video
                </a>
              ) : (
                <p class="text-sm text-iw-text-muted">Video not yet available</p>
              )}
            </div>
          )}
        </div>

        {/* Tags */}
        {video.tags && video.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {video.tags.map((tag) => (
              <a
                href={`/search?q=${encodeURIComponent(tag)}`}
                class="rounded-full border border-iw-border px-3 py-1 text-xs text-iw-text-secondary hover:border-iw-text-muted"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        {/* Transcript */}
        <div class="mt-8">
          <h2 class="mb-4 text-lg font-semibold text-white">Transcript</h2>
          {video.transcript ? (
            <div class="prose prose-invert max-w-none rounded-xl border border-iw-border p-6 text-sm text-iw-text-secondary">
              <div set:html={transcriptHtml} />
            </div>
          ) : (
            <p class="text-sm italic text-iw-text-muted">Transcript not yet available.</p>
          )}
        </div>

        {/* Related videos by same speaker */}
        {relatedBySpeaker.length > 0 && (
          <div class="mt-10 border-t border-iw-border pt-8">
            <h2 class="mb-4 text-lg font-semibold text-white">More by {video.speaker}</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {relatedBySpeaker.map((v) => (
                <a
                  href={`/videos/${v.slug}`}
                  class="rounded-lg border border-iw-border p-3 transition-colors hover:border-iw-text-muted/20 hover:bg-iw-surface"
                >
                  <p class="text-sm font-medium text-iw-text line-clamp-2">{v.title}</p>
                  <p class="mt-1 text-xs text-iw-text-muted">{v.duration || ''}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
</Base>
