---
/**
 * videos/index.astro — Videos listing (SSG content page).
 *
 * PURPOSE: Ports app/videos/page.tsx. Reads getMedia('video') from lib/data/media
 *   (framework-independent), renders VideosGridIsland (client:load).
 * REF: ports app/videos/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../layouts/Base.astro'
import { getMedia } from '@/lib/data/media'
import VideosGridIsland from '../../components/listings/VideosGridIsland'

const videos = getMedia('video')

const title = 'Videos — Islamic Lectures & Series'
const description =
  'Islamic video lectures and series with searchable transcripts and professional formatting.'
---

<Base title={title} description={description}>
  <main id="main-content">
    <div class="section-container py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white">Videos</h1>
        <p class="mt-2 text-iw-text-secondary">
          Islamic lectures and series from trusted scholars, with searchable transcripts.
        </p>
      </div>

      <VideosGridIsland videos={videos} client:load />
    </div>
  </main>
</Base>
