---
/**
 * audio/index.astro — Audio listing (SSG content page).
 *
 * PURPOSE: Ports app/audio/page.tsx. Reads getMedia('audio') from lib/data/media
 *   (framework-independent), renders AudioGridIsland (client:load).
 * REF: ports app/audio/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../layouts/Base.astro'
import { getMedia } from '@/lib/data/media'
import AudioGridIsland from '../../components/listings/AudioGridIsland'

const audios = getMedia('audio')

const title = 'Audio — Islamic Lectures & Recitations'
const description =
  'Islamic audio content: lectures, recitations, and podcasts with searchable transcripts.'
---

<Base title={title} description={description}>
  <main id="main-content">
    <div class="section-container py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white">Audio</h1>
        <p class="mt-2 text-iw-text-secondary">
          Islamic lectures, Quran recitations, and educational audio with searchable transcripts.
        </p>
      </div>

      <AudioGridIsland audios={audios} client:load />
    </div>
  </main>
</Base>
