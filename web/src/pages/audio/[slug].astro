---
/**
 * audio/[slug].astro — Audio detail page (SSG, dynamic route).
 *
 * PURPOSE: Ports app/audio/[slug]/page.tsx. getStaticParams → getStaticPaths
 *   over getMedia('audio'). Renders player embed + transcript + related-by-speaker.
 * SECURITY (HARD / XSS): Both untrusted HTML sinks are sanitized SERVER-SIDE here
 *   in the frontmatter, exactly as the Next page did at the call site:
 *     - audio.embed_code → sanitizeEmbed()  (iframe origin allowlist)
 *     - audio.transcript → sanitizeHtml()   (tag/attr allowlist + data: strip)
 *   The sanitized strings are emitted via set:html — raw values never reach output.
 * REF: ports app/audio/[slug]/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../layouts/Base.astro'
import { getMediaBySlug, getMedia } from '@/lib/data/media'
import { sanitizeHtml, sanitizeEmbed } from '@/lib/sanitize'
import { ogImageUrl } from '@/lib/og'
import { getHreflangAlternates } from '@/components/seo/hreflang'

// Static content page — prerendered to HTML at build time (SSG content/SEO).
export const prerender = true

export function getStaticPaths() {
  return getMedia('audio').map((a) => ({ params: { slug: a.slug } }))
}

const { slug } = Astro.params
const audio = getMediaBySlug(slug!)
if (!audio || audio.type !== 'audio') {
  return Astro.redirect('/404')
}

const relatedBySpeaker = audio.speaker
  ? getMedia('audio')
      .filter((a) => a.speaker === audio.speaker && a.slug !== audio.slug)
      .slice(0, 6)
  : []

// XSS gate — sanitize server-side before set:html.
const embedHtml = audio.embed_code ? sanitizeEmbed(audio.embed_code) : ''
const transcriptHtml = audio.transcript ? sanitizeHtml(audio.transcript) : ''

const title = audio.title
const description = `Listen to ${audio.title}${audio.speaker ? ` by ${audio.speaker}` : ''}. Full transcript available.`
const ogImage = ogImageUrl({ title: audio.title, section: 'Audio', subtitle: audio.speaker || '' })
const hreflang = getHreflangAlternates(`/audio/${slug}`)
---

<Base title={title} description={description} ogImage={ogImage}>
  {Object.entries(hreflang).map(([lang, href]) => (
    <link slot="head" rel="alternate" hreflang={lang} href={href} />
  ))}
  <main id="main-content">
    <div class="section-container py-12">
      <nav class="mb-4 text-sm text-iw-text-secondary">
        <a href="/audio" class="hover:text-iw-text">Audio</a>
        <span class="mx-2">/</span>
        <span class="text-iw-text">{audio.title}</span>
      </nav>

      <div class="mx-auto max-w-3xl">
        <h1 class="text-2xl font-bold text-white">{audio.title}</h1>
        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-iw-text-secondary">
          {audio.speaker && <span class="text-iw-accent">{audio.speaker}</span>}
          {audio.duration && <span>{audio.duration}</span>}
        </div>

        {/* Audio player */}
        <div class="mt-6 rounded-xl border border-iw-border bg-iw-surface p-6">
          {audio.embed_code ? (
            <div set:html={embedHtml} />
          ) : (
            <div class="flex items-center gap-4">
              <svg class="h-10 w-10 text-iw-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
              {audio.external_url ? (
                <a
                  href={audio.external_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-iw-accent/15 px-4 py-2 text-sm font-medium text-iw-accent hover:bg-iw-accent/25"
                >
                  Listen
                </a>
              ) : (
                <p class="text-sm text-iw-text-muted">Audio not yet available</p>
              )}
            </div>
          )}
        </div>

        {/* Tags */}
        {audio.tags && audio.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {audio.tags.map((tag) => (
              <a
                href={`/search?q=${encodeURIComponent(tag)}`}
                class="rounded-full border border-iw-border px-3 py-1 text-xs text-iw-text-secondary hover:border-iw-text-muted"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        {/* Transcript */}
        <div class="mt-8">
          <h2 class="mb-4 text-lg font-semibold text-white">Transcript</h2>
          {audio.transcript ? (
            <div class="prose prose-invert max-w-none rounded-xl border border-iw-border p-6 text-sm text-iw-text-secondary">
              <div set:html={transcriptHtml} />
            </div>
          ) : (
            <p class="text-sm italic text-iw-text-muted">Transcript not yet available.</p>
          )}
        </div>

        {/* Related audio by same speaker */}
        {relatedBySpeaker.length > 0 && (
          <div class="mt-10 border-t border-iw-border pt-8">
            <h2 class="mb-4 text-lg font-semibold text-white">More by {audio.speaker}</h2>
            <div class="space-y-2">
              {relatedBySpeaker.map((a) => (
                <a
                  href={`/audio/${a.slug}`}
                  class="flex items-center gap-3 rounded-lg border border-iw-border p-3 transition-colors hover:border-iw-text-muted/20 hover:bg-iw-surface"
                >
                  <svg class="h-5 w-5 shrink-0 text-iw-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  </svg>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-iw-text truncate">{a.title}</p>
                    <p class="text-xs text-iw-text-muted">{a.duration || ''}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
</Base>
