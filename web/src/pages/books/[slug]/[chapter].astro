---
/**
 * books/[slug]/[chapter].astro — Book chapter reader (/books/:slug/:chapter, SSR on-demand).
 *
 * PURPOSE: Ports app/books/[slug]/[chapter]/page.tsx. Renders chapter sidebar,
 *   header, language tabs (island), taxonomy, and prev/next nav.
 * STACK NOTE: Converted from prerender=true to SSR because ~7,926 book/chapter
 *   combinations caused build explosion. Matches the original Next ISR intent.
 * SECURITY (HARD / XSS): The EN/AR/ID chapter HTML is sanitized SERVER-SIDE here
 *   via lib/sanitize sanitizeHtml() BEFORE being passed into ChapterLangTabsIsland.
 *   The Next page sanitized inside the client ChapterLangTabs component; here the
 *   sanitization is hoisted to the server frontmatter so the island boundary only
 *   ever carries already-sanitized markup. No raw chapter HTML reaches the client.
 * REF: ports app/books/[slug]/[chapter]/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../../layouts/Base.astro'
// Runtime fetch-based reader — reads single records over HTTP from /content-data/ so the
// 1GB content corpus is NOT bundled into the Vercel serverless function. Do NOT import
// from '@/lib/data/books' here: its fs.readFileSync/readdirSync over process.cwd()/data
// make the Vercel tracer pull the entire data/ tree into this function (the 1.1GB bloat).
import { getBookBySlug, getChaptersByBook, getChapter } from '@/lib/data/runtime-data'
import { sanitizeHtml } from '@/lib/sanitize'
import { ogImageUrl } from '@/lib/og'
import ChapterLangTabsIsland from '../../../components/books/ChapterLangTabsIsland'
import ChapterTaxonomy from '../../../components/books/ChapterTaxonomy.astro'

// On-demand SSR — too many book/chapter pairs (~7,926) to prerender at build time.
export const prerender = false

const { slug, chapter: chNum } = Astro.params
const book = await getBookBySlug(slug!)
if (!book) {
  return Astro.redirect('/404')
}

const chapterNumber = parseInt(chNum!, 10)
const ch = await getChapter(slug!, chapterNumber)
if (!ch) {
  return Astro.redirect('/404')
}

const allChapters = await getChaptersByBook(slug!)
const idx = allChapters.findIndex((c) => c.number === chapterNumber)
const prevChapter = idx > 0 ? allChapters[idx - 1] : null
const nextChapter = idx < allChapters.length - 1 ? allChapters[idx + 1] : null
const isIntro = chapterNumber === 0
const nonIntroCount = allChapters.filter((c) => c.number !== 0).length

function chapterLabel(num: number, title: string) {
  return num === 0 ? title : `${num}. ${title}`
}

function estimateReadingTime(html: string | undefined): number {
  if (!html) return 0
  const text = html.replace(/<[^>]+>/g, ' ')
  const words = text.trim().split(/\s+/).filter(Boolean).length
  return Math.max(1, Math.ceil(words / 220))
}
const readMinutes = estimateReadingTime(ch.content_en)

// XSS gate — sanitize each language variant server-side before it crosses the
// island boundary. sanitizeHtml() = same call the Next ChapterLangTabs made.
const sanitizedEn = ch.content_en ? sanitizeHtml(ch.content_en) : undefined
const sanitizedAr = ch.content_ar ? sanitizeHtml(ch.content_ar) : undefined
const sanitizedId = ch.content_id ? sanitizeHtml(ch.content_id) : undefined

const title = ch ? `${ch.title_en} — ${book.title_en}` : book.title_en
const description = `${chapterNumber === 0 ? 'Introduction to' : `Chapter ${chNum} of`} ${book.title_en} by ${book.author_name_en}.`
const ogImage = ogImageUrl({ title: ch ? ch.title_en : book.title_en, section: 'Books', subtitle: book.title_en })
---

<Base title={title} description={description} ogImage={ogImage}>
  <main id="main-content">
    <div class="section-container py-12">
      <nav class="mb-4 text-sm text-iw-text-secondary">
        <a href="/books" class="hover:text-iw-text">Books</a>
        <span class="mx-2">/</span>
        <a href={`/books/${slug}`} class="hover:text-iw-text">{book.title_en}</a>
        <span class="mx-2">/</span>
        <span class="text-iw-text">{isIntro ? 'Introduction' : `Ch. ${chapterNumber}`}</span>
      </nav>

      <div class="flex gap-10 xl:gap-16">
        {/* Sidebar: Chapter list */}
        {allChapters.length > 1 && (
          <aside class="hidden w-56 flex-shrink-0 lg:block">
            <div class="sticky top-28">
              <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-iw-text-muted">Chapters</p>
              <nav class="max-h-[70vh] space-y-0.5 overflow-y-auto border-l border-iw-border/60 pl-3">
                {allChapters.map((c) => (
                  <a
                    href={`/books/${slug}/${c.number}`}
                    class={`block py-1 text-[13px] leading-snug transition-colors ${
                      c.number === chapterNumber
                        ? 'font-medium text-iw-accent'
                        : 'text-iw-text-muted hover:text-iw-accent'
                    }`}
                  >
                    {chapterLabel(c.number, c.title_en)}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )}

        {/* Main content */}
        <div class="min-w-0 flex-1">
          <header class="mb-8">
            <p class="text-sm text-iw-text-muted">
              {isIntro ? 'Editorial Introduction' : `Chapter ${chapterNumber} of ${nonIntroCount}`}
              {readMinutes > 0 && (
                <span class="before:mx-2 before:content-['·']">{readMinutes} min read</span>
              )}
            </p>
            <h1 class="mt-1 text-2xl font-bold text-white">{ch.title_en}</h1>
            {ch.title_ar && (
              <p class="arabic-text mt-2 text-lg text-white/80" dir="rtl" lang="ar">{ch.title_ar}</p>
            )}
          </header>

          {/* Language tabs: EN / AR / ID — content sanitized server-side above */}
          <ChapterLangTabsIsland
            contentEn={sanitizedEn}
            contentAr={sanitizedAr}
            contentId={sanitizedId}
            client:load
          />

          {/* Taxonomy: tags, refs (hidden if empty) */}
          <ChapterTaxonomy
            subjectTags={ch.subject_tags}
            topicTags={ch.topic_tags}
            keywords={ch.keywords}
            peopleRefs={ch.people_refs}
            ayahRefs={ch.ayah_refs}
            hadithRefs={ch.hadith_refs}
          />

          {/* Prev/next */}
          <div class="mt-10 grid grid-cols-2 gap-4 border-t border-iw-border pt-6">
            {prevChapter ? (
              <a
                href={`/books/${slug}/${prevChapter.number}`}
                class="group rounded-lg border border-iw-border p-4 transition-colors hover:border-iw-text-muted/20"
              >
                <span class="text-xs text-iw-text-muted">Previous</span>
                <p class="mt-1 text-sm font-medium text-iw-text-secondary group-hover:text-iw-accent">
                  {chapterLabel(prevChapter.number, prevChapter.title_en)}
                </p>
              </a>
            ) : <div />}
            {nextChapter ? (
              <a
                href={`/books/${slug}/${nextChapter.number}`}
                class="group rounded-lg border border-iw-border p-4 text-right transition-colors hover:border-iw-text-muted/20"
              >
                <span class="text-xs text-iw-text-muted">Next</span>
                <p class="mt-1 text-sm font-medium text-iw-text-secondary group-hover:text-iw-accent">
                  {chapterLabel(nextChapter.number, nextChapter.title_en)}
                </p>
              </a>
            ) : <div />}
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
