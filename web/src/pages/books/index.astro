---
/**
 * books/index.astro — Books listing (SSG content page).
 *
 * PURPOSE: Ports app/books/page.tsx. Reads getBooks() from lib/data/books
 *   (framework-independent) in the frontmatter, renders the BooksGridIsland
 *   (client:load) for search/pagination/category tabs.
 * REF: ports app/books/page.tsx · D-P2-STACK-CANON
 */
import Base from '../../layouts/Base.astro'
import { getBooks } from '@/lib/data/books'
import { getHreflangAlternates } from '@/components/seo/hreflang'
import BooksGridIsland from '../../components/listings/BooksGridIsland'

const books = getBooks()
const hreflang = getHreflangAlternates('/books')

const title = 'Books — Classical Islamic Texts'
const description =
  'Browse classical Islamic books: hadith collections, fiqh manuals, tafsir works, aqeedah texts, and seerah. Read online in multiple languages.'
---

<Base title={title} description={description}>
  {Object.entries(hreflang).map(([lang, href]) => (
    <link slot="head" rel="alternate" hreflang={lang} href={href} />
  ))}
  <main id="main-content">
    <div class="section-container py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white">Books</h1>
        <p class="mt-2 text-iw-text-secondary">
          Classical Islamic texts spanning hadith, fiqh, tafsir, aqeedah, history, and more.
        </p>
      </div>

      <BooksGridIsland books={books} client:load />
    </div>
  </main>
</Base>
