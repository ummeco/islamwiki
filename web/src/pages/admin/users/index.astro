---
/**
 * admin/users/index.astro — user management (server list + UserManagement island)
 *
 * PURPOSE: Ports app/admin/users/page.tsx. Server-reads the user list (admin secret stays
 *   server-only) and hands a sanitized projection to the UserManagement island, which mutates
 *   trust/role/ban via /api/admin/users.
 *
 * AUTH GUARD (server-side, preserved + defense-in-depth):
 *   src/middleware.ts gates /admin* at trustLevel>=4; re-checked here. /api/admin/users
 *   independently re-verifies the caller and enforces every rank guard.
 * REF: ports app/admin/users (auth-interactive migration group)
 */
import Base from '../../../layouts/Base.astro'
import { getUsers } from '../../../../lib/data/users'
import { UserManagement } from '../../../components/admin/UserManagement'

export const prerender = false

if ((Astro.locals.trustLevel ?? 0) < 4) {
  return Astro.redirect('/', 302)
}

const users = getUsers().map((u) => ({
  id: u.id,
  username: u.username,
  display_name: u.display_name,
  email: u.email,
  role: u.role,
  trust_level: u.trust_level,
  total_edits: u.total_edits,
  approved_edits: u.approved_edits,
  banned: u.banned || false,
  created_at: u.created_at,
}))
---

<Base title="User Management | Islam.wiki" description="Manage user accounts, trust levels, and roles.">
  <div class="section-container py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">User Management</h1>
      <p class="mt-2 text-sm text-iw-text-secondary">
        Manage trust levels, roles, and account status for all users.
      </p>
    </div>

    <UserManagement users={users} client:load />
  </div>
</Base>
