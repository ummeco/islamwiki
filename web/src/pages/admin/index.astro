---
/**
 * admin/index.astro — Admin dashboard (server-rendered stats)
 *
 * PURPOSE: Ports app/admin/page.tsx. Server-renders pending/recent revision counts and content
 *   stats. No island — purely static server output + links.
 *
 * AUTH GUARD (server-side, preserved + defense-in-depth):
 *   src/middleware.ts already requires trustLevel>=4 for any /admin* path (redirects to / below).
 *   This frontmatter re-checks Astro.locals.trustLevel and redirects to / if <4, so the page never
 *   renders admin data even if the matcher were bypassed. The Hasura admin secret used by the data
 *   readers stays server-only (frontmatter runs on the server; nothing is passed to a client island).
 * REF: ports app/admin (auth-interactive migration group)
 */
import Base from '../../layouts/Base.astro'
import { getPendingRevisions, getRecentReviewedRevisions } from '../../../lib/contributor/revisions'
import { getArticles } from '../../../lib/data/articles'
import { getWikiPages } from '../../../lib/data/wiki'
import { getPeople } from '../../../lib/data/people'
import { getBooks } from '../../../lib/data/books'
import { getSeerahEvents } from '../../../lib/data/seerah'

export const prerender = false

// Defense-in-depth: middleware already gates /admin* at trustLevel>=4.
if ((Astro.locals.trustLevel ?? 0) < 4) {
  return Astro.redirect('/', 302)
}

const [pending, recentEdits] = await Promise.all([
  getPendingRevisions(10).catch(() => []),
  getRecentReviewedRevisions(10).catch(() => []),
])
const pendingEdits = pending
const articles = getArticles()
const wikiPages = getWikiPages()
const people = getPeople()
const books = getBooks()
const seerahEvents = getSeerahEvents()

const contentStats = [
  { label: 'Quran Surahs', count: 114 },
  { label: 'Hadith Collections', count: 12 },
  { label: 'People', count: people.length },
  { label: 'Books', count: books.length },
  { label: 'Articles', count: articles.length },
  { label: 'Wiki Pages', count: wikiPages.length },
  { label: 'Seerah Events', count: seerahEvents.length },
]

const moderationLinks = [
  { href: '/admin/edits', label: 'Review Pending Edits', count: pendingEdits.length },
  { href: '/admin/users', label: 'Manage Users', count: null as number | null },
  { href: '/admin/ai-reviews', label: 'AI Review Queue', count: 0 },
]
---

<Base title="Admin Dashboard | Islam.wiki" description="Islam.wiki administration panel.">
  <div class="section-container py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Admin Dashboard</h1>
      <p class="mt-2 text-sm text-iw-text-secondary">
        Content moderation, user management, and site administration.
      </p>
    </div>

    {/* Quick Stats */}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/admin/edits" class="rounded-xl border border-iw-border bg-iw-surface p-4 transition-colors hover:border-iw-border">
        <p class="text-2xl font-bold text-white">{pendingEdits.length}</p>
        <p class="text-sm text-iw-text-secondary">Pending Edits</p>
      </a>
      <a href="/admin/users" class="rounded-xl border border-iw-border bg-iw-surface p-4 transition-colors hover:border-iw-border">
        <p class="text-2xl font-bold text-white">—</p>
        <p class="text-sm text-iw-text-secondary">Users</p>
      </a>
      <a href="/admin/ai-reviews" class="rounded-xl border border-iw-border bg-iw-surface p-4 transition-colors hover:border-iw-border">
        <p class="text-2xl font-bold text-white">0</p>
        <p class="text-sm text-iw-text-secondary">AI Reviews</p>
      </a>
      <a href="/recent-changes" class="rounded-xl border border-iw-border bg-iw-surface p-4 transition-colors hover:border-iw-border">
        <p class="text-2xl font-bold text-white">{recentEdits.length}</p>
        <p class="text-sm text-iw-text-secondary">Recent Edits</p>
      </a>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {/* Content Stats */}
      <div class="rounded-xl border border-iw-border bg-iw-surface p-5">
        <h2 class="mb-4 text-lg font-semibold text-white">Content Stats</h2>
        <dl class="space-y-2.5 text-sm">
          {contentStats.map((row) => (
            <div class="flex justify-between">
              <dt class="text-iw-text-secondary">{row.label}</dt>
              <dd class="font-medium text-iw-text">{row.count}</dd>
            </div>
          ))}
        </dl>
      </div>

      {/* Moderation Links */}
      <div class="rounded-xl border border-iw-border bg-iw-surface p-5">
        <h2 class="mb-4 text-lg font-semibold text-white">Moderation</h2>
        <nav class="space-y-2">
          {moderationLinks.map((link) => (
            <a
              href={link.href}
              class="flex items-center justify-between rounded-lg border border-iw-border px-3 py-2 text-sm text-iw-text-secondary transition-colors hover:border-iw-accent/30 hover:bg-iw-surface hover:text-white"
            >
              <span>{link.label}</span>
              {link.count !== null && (
                <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${link.count > 0 ? 'bg-amber-500/20 text-amber-400' : 'bg-iw-surface text-iw-text-muted'}`}>
                  {link.count}
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>
    </div>

    {/* Recent Activity */}
    {recentEdits.length > 0 && (
      <div class="mt-6 rounded-xl border border-iw-border bg-iw-surface p-5">
        <h2 class="mb-4 text-lg font-semibold text-white">Recent Activity</h2>
        <div class="space-y-2">
          {recentEdits.map((rev) => (
            <div class="flex items-center gap-3 text-sm">
              <span
                class={`rounded px-1.5 py-0.5 text-xs font-medium ${
                  rev.status === 'approved'
                    ? 'bg-emerald-500/15 text-emerald-400'
                    : rev.status === 'pending'
                      ? 'bg-amber-500/15 text-amber-400'
                      : 'bg-red-500/15 text-red-400'
                }`}
              >
                {rev.status}
              </span>
              <span class="text-iw-text">{rev.content_type}/{rev.content_slug}</span>
              <span class="text-iw-text-secondary/50">&middot;</span>
              <span class="text-xs text-iw-text-secondary/70">{rev.editor_username}</span>
              <span class="text-xs text-iw-text-secondary/50">{new Date(rev.created_at).toLocaleDateString()}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>
