---
/**
 * SectionHeader.astro — colored section banner. Ports the SectionHeader sub-component
 *   from app/sects/page.tsx (static). REF: ports app/sects/page.tsx · people-history group
 */
interface Props {
  icon: string
  title: string
  subtitle: string
  variant: 'green' | 'amber' | 'red'
}
const { icon, title, subtitle, variant } = Astro.props

const borderCls =
  variant === 'green'
    ? 'border-emerald-500/40 bg-emerald-500/5'
    : variant === 'amber'
      ? 'border-amber-500/40 bg-amber-500/5'
      : 'border-red-500/40 bg-red-500/5'
const titleCls =
  variant === 'green'
    ? 'text-emerald-300'
    : variant === 'amber'
      ? 'text-amber-300'
      : 'text-red-300'
---

<div class={`mb-6 rounded-xl border p-5 ${borderCls}`}>
  <div class="flex items-center gap-3">
    <span class="text-2xl">{icon}</span>
    <div>
      <h2 class={`text-xl font-bold ${titleCls}`}>{title}</h2>
      <p class="mt-0.5 text-sm text-iw-text-secondary">{subtitle}</p>
    </div>
  </div>
</div>
