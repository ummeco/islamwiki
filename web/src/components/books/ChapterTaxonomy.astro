---
/**
 * ChapterTaxonomy.astro — static taxonomy block for a book chapter.
 *
 * PURPOSE: Ports components/books/ChapterTaxonomy.tsx. It has no interactivity
 *   (only static links), so it renders as a pure Astro component — no island /
 *   hydration needed. next/link → plain <a>.
 * INPUTS: subjectTags/topicTags/keywords/peopleRefs/ayahRefs/hadithRefs (string[]).
 * OUTPUTS: <aside> with related topics/keywords/people/quran/hadith links, or null.
 * REF: ports components/books/ChapterTaxonomy.tsx · D-P2-STACK-CANON
 */
interface Props {
  subjectTags?: string[]
  topicTags?: string[]
  keywords?: string[]
  peopleRefs?: string[]
  ayahRefs?: string[]
  hadithRefs?: string[]
}

const { subjectTags, topicTags, keywords, peopleRefs, ayahRefs, hadithRefs } = Astro.props

function isEmpty(arr?: string[]): boolean {
  return !arr || arr.length === 0
}

const allEmpty =
  isEmpty(subjectTags) &&
  isEmpty(topicTags) &&
  isEmpty(keywords) &&
  isEmpty(peopleRefs) &&
  isEmpty(ayahRefs) &&
  isEmpty(hadithRefs)
---

{!allEmpty && (
  <aside class="mt-10 border-t border-iw-border pt-6">
    <p class="mb-4 text-[11px] font-bold uppercase tracking-widest text-iw-text-muted">Related</p>

    {(!isEmpty(subjectTags) || !isEmpty(topicTags)) && (
      <div class="mb-4">
        <p class="mb-2 text-xs text-iw-text-muted">Topics</p>
        <div class="flex flex-wrap gap-1.5">
          {subjectTags?.map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class="rounded-full bg-iw-accent/10 px-2.5 py-0.5 text-xs text-iw-accent hover:bg-iw-accent/20"
            >
              {tag}
            </a>
          ))}
          {topicTags?.map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class="rounded-full bg-iw-surface px-2.5 py-0.5 text-xs text-iw-text-secondary hover:text-iw-accent"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    )}

    {!isEmpty(keywords) && (
      <div class="mb-4">
        <p class="mb-2 text-xs text-iw-text-muted">Keywords</p>
        <div class="flex flex-wrap gap-1">
          {keywords?.map((kw) => (
            <a
              href={`/search?q=${encodeURIComponent(kw)}`}
              class="rounded bg-iw-surface/50 px-2 py-0.5 text-[11px] text-iw-text-muted hover:text-iw-accent"
            >
              {kw}
            </a>
          ))}
        </div>
      </div>
    )}

    {!isEmpty(peopleRefs) && (
      <div class="mb-4">
        <p class="mb-2 text-xs text-iw-text-muted">People Mentioned</p>
        <div class="flex flex-wrap gap-1.5">
          {peopleRefs?.map((slug) => (
            <a
              href={`/people/${slug}`}
              class="rounded-full border border-iw-border px-2.5 py-0.5 text-xs text-iw-text-secondary hover:border-iw-accent hover:text-iw-accent"
            >
              {slug.replace(/-/g, ' ')}
            </a>
          ))}
        </div>
      </div>
    )}

    {!isEmpty(ayahRefs) && (
      <div class="mb-4">
        <p class="mb-2 text-xs text-iw-text-muted">Quran References</p>
        <div class="flex flex-wrap gap-1.5">
          {ayahRefs?.map((ref) => (
            <a
              href={`/quran/${ref}`}
              class="rounded-full border border-iw-border px-2.5 py-0.5 text-xs font-mono text-iw-text-secondary hover:border-iw-accent hover:text-iw-accent"
            >
              {ref}
            </a>
          ))}
        </div>
      </div>
    )}

    {!isEmpty(hadithRefs) && (
      <div class="mb-4">
        <p class="mb-2 text-xs text-iw-text-muted">Hadith References</p>
        <div class="flex flex-wrap gap-1.5">
          {hadithRefs?.map((ref) => (
            <a
              href={`/hadith/${ref}`}
              class="rounded-full border border-iw-border px-2.5 py-0.5 text-xs font-mono text-iw-text-secondary hover:border-iw-accent hover:text-iw-accent"
            >
              {ref}
            </a>
          ))}
        </div>
      </div>
    )}
  </aside>
)}
