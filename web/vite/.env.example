# Islam.wiki Editor Surface (Vite SPA) — Environment Variables
# Copy to .env.local for local development

# GraphQL endpoint (VITE_ prefix for client exposure)
VITE_GRAPHQL_URL=https://api.ummat.dev/v1/graphql

# WebSocket for real-time subscriptions (save-draft)
VITE_GRAPHQL_WS_URL=wss://api.ummat.dev/v1/graphql

# Auth endpoint
VITE_AUTH_URL=https://auth.ummat.dev

# Editor base URL
VITE_EDITOR_BASE_URL=https://editor.islam.wiki

# Read zone site URL (for links back to published articles)
VITE_SITE_URL=https://islam.wiki

# Sentry — vault key SENTRY_DSN_ISLAMWIKI
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ummeco
SENTRY_PROJECT=islamwiki-editor

# Umami analytics
VITE_UMAMI_WEBSITE_ID=
