{
  "name": "islamwiki-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Islam.wiki — Vite 7 + React 19 SPA editor surface. Authed wiki editors, TipTap rich-text, revision workflow, moderation queue.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3042",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "codegen": "graphql-codegen --config ../codegen.ts --output-dir src/graphql/generated"
  },
  "dependencies": {
    "@sentry/react": "^8.0.0",
    "@sentry/vite-plugin": "^2.0.0",
    "@tiptap/core": "^2.0.0",
    "@tiptap/extension-code-block": "^2.0.0",
    "@tiptap/extension-image": "^2.0.0",
    "@tiptap/extension-link": "^2.0.0",
    "@tiptap/extension-table": "^2.0.0",
    "@tiptap/extension-table-cell": "^2.0.0",
    "@tiptap/extension-table-header": "^2.0.0",
    "@tiptap/extension-table-row": "^2.0.0",
    "@tiptap/extension-character-count": "^2.0.0",
    "@tiptap/extension-placeholder": "^2.0.0",
    "@tiptap/pm": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "@ummat/auth-core": "workspace:*",
    "@ummat/graphql-client": "workspace:*",
    "@ummat/i18n": "workspace:*",
    "@ummat/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-diff-viewer-continued": "^4.0.0",
    "react-router-dom": "^6.0.0",
    "urql": "^4.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "axe-core": "^4.0.0",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
