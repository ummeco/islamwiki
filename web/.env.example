# Islam.wiki — Environment Variables
# Copy this to .env.local and fill in values

# Hasura GraphQL (server-side admin + browser public)
NEXT_PUBLIC_HASURA_URL=https://api.islam.wiki/graphql
HASURA_ADMIN_URL=https://api.ummat.dev/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=

# Auth
NEXT_PUBLIC_AUTH_URL=https://auth.ummat.dev

# Auth client URL scoped to THIS app — tells Hasura Auth where to redirect after email confirm.
# Prod: sourced from vault AUTH_CLIENT_URL_ISLAMWIKI.
AUTH_CLIENT_URL=https://islam.wiki

# Remote Schema (Hasura sends this header when calling /api/graphql)
REMOTE_SCHEMA_SECRET=

# Iron-session (Phase 1 only — remove when migrating to Hasura Auth)
SESSION_SECRET=

# AI (Anthropic Claude — content moderation + summarisation)
ANTHROPIC_API_KEY=
# Optional: multi-key rotation pool
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Meilisearch (S9-11 — full-text search across all corpora)
# MEILISEARCH_HOST is the canonical var name (replaces MEILISEARCH_URL)
MEILISEARCH_HOST=https://search.islam.wiki
MEILISEARCH_ADMIN_KEY=
MEILISEARCH_SEARCH_KEY=

# Audio (no key needed — EveryAyah.com is a free CDN)
# NEXT_PUBLIC_AUDIO_CDN=https://everyayah.com/data

# Monitoring — Sentry (S9-05)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN enables source-map upload during Vercel/CI builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ummeco
SENTRY_PROJECT=islamwiki-web

# Monitoring — Umami analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
