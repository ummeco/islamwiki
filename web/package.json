{
  "name": "islamwiki-web",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3041",
    "build": "next build",
    "start": "next start --port 3041",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "index:quran": "tsx scripts/index/index-quran.ts",
    "index:hadith": "tsx scripts/index/index-hadith.ts",
    "index:books": "tsx scripts/index/index-books.ts",
    "index:people": "tsx scripts/index/index-people.ts",
    "index:articles": "tsx scripts/index/index-articles.ts",
    "index:all": "pnpm index:quran && pnpm index:hadith && pnpm index:books && pnpm index:people && pnpm index:articles",
    "setup": "pnpx tsx ~/Sites/ummeco/scripts/setup.sh",
    "doctor": "pnpx tsx ~/Sites/ummeco/scripts/doctor.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "env:refresh": "bash ~/Sites/ummeco/scripts/env-refresh.sh",
    "console:hasura": "open http://localhost:5543",
    "console:mail": "open http://localhost:5043",
    "console:storage": "open http://localhost:5443",
    "console:search": "open http://localhost:7700"
  },
  "dependencies": {
    "@ummat/consent": "file:./vendor/consent",
    "@anthropic-ai/sdk": "^0.91.1",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@sentry/nextjs": "^9.0.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "diff": "^8.0.3",
    "isomorphic-dompurify": "^3.10.0",
    "jose": "^6.2.1",
    "leaflet": "^1.9.4",
    "marked": "^17.0.3",
    "meilisearch": "^0.58.0",
    "next": "16.2.5",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/diff": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "ioredis": "^5.10.1",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.14",
      "serialize-javascript": ">=7.0.3",
      "vite": "8.0.10"
    }
  }
}