{
  "name": "islamwiki-web",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 3040",
    "build": "astro build",
    "preview": "astro preview --port 3040",
    "start": "astro preview --port 3040",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "index:quran": "tsx scripts/index/index-quran.ts",
    "index:hadith": "tsx scripts/index/index-hadith.ts",
    "index:books": "tsx scripts/index/index-books.ts",
    "index:people": "tsx scripts/index/index-people.ts",
    "index:articles": "tsx scripts/index/index-articles.ts",
    "index:all": "pnpm index:quran && pnpm index:hadith && pnpm index:books && pnpm index:people && pnpm index:articles",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "env:refresh": "bash ~/Sites/ummeco/scripts/env-refresh.sh",
    "console:hasura": "open http://localhost:5543",
    "console:mail": "open http://localhost:5043",
    "console:storage": "open http://localhost:5443",
    "console:search": "open http://localhost:7700"
  },
  "dependencies": {
    "@ummat/consent": "file:./vendor/consent",
    "@ummat/errors": "file:./vendor/errors",
    "@ummat/ui": "file:./vendor/ui",
    "@anthropic-ai/sdk": "^0.91.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/vercel": "^10.0.8",
    "@sentry/astro": "^10.61.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^6.4.6",
    "diff": "^8.0.3",
    "isomorphic-dompurify": "^3.10.0",
    "jose": "^6.2.1",
    "leaflet": "^1.9.4",
    "marked": "^17.0.3",
    "meilisearch": "^0.58.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reactflow": "^11.11.4",
    "server-only": "^0.0.1",
    "urql": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/diff": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^3.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.3.0",
    "ioredis": "^5.10.1",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "next"
      ]
    },
    "overrides": {
      "@grpc/grpc-js": ">=1.14.4 <2",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0 <3",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "browserslist": ">=4.28.7 <5",
      "esbuild": ">=0.28.1 <1",
      "fast-uri": ">=3.1.6 <4",
      "flatted": ">=3.4.2",
      "html-encoding-sniffer": "4.0.0",
      "js-yaml": ">=4.3.1 <5",
      "jsdom": "26.1.0",
      "nanoid@3": "3.3.18",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18 <9",
      "protobufjs": ">=7.6.1",
      "serialize-javascript": ">=7.0.3",
      "sharp": ">=0.35.0 <0.36",
      "svgo": ">=4.0.2 <5",
      "tar": ">=7.5.21 <8",
      "undici": ">=7.28.0 <8",
      "vite": ">=7.3.5 <8",
      "ws": ">=8.21.0"
    }
  }
}
