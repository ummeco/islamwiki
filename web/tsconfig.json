{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strictNullChecks": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "astro.config.mjs", "env.d.ts", "lib"],
  "exclude": [
    "node_modules",
    "dist",
    ".astro",
    ".vercel",
    "app",
    "astro",
    "vite",
    "workers",
    "scripts/index",
    "scripts/seed-quran-hadith-crossrefs.ts",
    "codegen.ts"
  ]
}
